# Copy this file to `.env` in the same folder and adjust values.
# Never commit the real `.env` file.

NODE_ENV=development
PORT=4002

# Leave unset in most cases (defaults to "true" whenever NODE_ENV=production).
# Set explicitly to "false" if you're running NODE_ENV=production directly
# over plain HTTP with no reverse-proxy TLS in front yet (e.g. testing on a
# server via http://<ip>:4002 before DNS/certs are set up) - otherwise the
# browser silently refuses to send back the (Secure-flagged) session cookie
# after login, and the CSP forces the JS/CSS bundle to fetch over https://,
# which doesn't exist yet, so the page renders blank. Once you do put TLS in
# front (see DEPLOY.md), remove this line (or set it back to "true").
# HTTPS_ENABLED=false

# Browser CORS allow-list (comma separated). Same-origin requests (the normal
# case, since dashboard/portal are served from this same port) do not need
# this. Native Flutter HTTP calls are not subject to browser CORS at all.
CORS_ORIGINS=http://localhost:4002

# --- Secrets -----------------------------------------------------------
# MUST be a long random value in any shared/deployed environment. The server
# refuses to start in production with the placeholder below.
JWT_SECRET=change-me-to-a-long-random-value-before-deploying
JWT_EXPIRES_IN=8h

# --- Demo credentials (mockup only) ------------------------------------
# These seed the two demo accounts used to preview the otherwise-internal
# /dashboard and /portal apps during this early mockup phase. They are NOT a
# substitute for the real per-user accounts + RBAC described in the product
# proposal, and must be rotated/removed before any non-local deployment.
DASHBOARD_DEMO_USER=admin
DASHBOARD_DEMO_PASS=admin
PORTAL_DEMO_USER=portal
PORTAL_DEMO_PASS=portal

# Internal Vite dev server the API proxies non-/api requests to. Only used
# when NODE_ENV=development; ignored in production (static files are served
# directly from web/dist instead).
VITE_DEV_SERVER=http://127.0.0.1:5173
